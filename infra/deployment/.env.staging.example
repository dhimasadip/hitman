# Copy to .env.staging on the deployment host or inject these values from the
# platform secret store. Never commit populated files.
POSTGRES_DB=hitman
POSTGRES_USER=hitman
POSTGRES_PASSWORD=replace-with-a-secret-manager-value
METRICS_TOKEN=replace-with-a-32-byte-random-token
COOKIE_SECURE=true
LOG_LEVEL=info
SERVICE_VERSION=0.1.0
GIT_COMMIT=unknown
BUILD_TIME=unknown
HITMAN_NODE_IMAGE=registry.example/hitman-node:0.1.0
HITMAN_WEB_IMAGE=registry.example/hitman-web:0.1.0
HTTPS_PORT=8443
HTTP_PORT=8088
