# ---------------------------------------------------------------------------
# Hitman environment template. Copy to .env and fill local-only values.
# Never commit real credentials. Secrets in request/environment records must
# be references (for example env://HITMAN_SECRET_EXAMPLE_TOKEN), not values.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Development cluster created by `pnpm db:dev start`.
DATABASE_URL=postgres://hitman@127.0.0.1:5433/hitman_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_CONNECT_TIMEOUT_MS=5000
DB_HEALTH_TIMEOUT_MS=2000

# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://hitman@127.0.0.1:5433/hitman_test

SERVICE_VERSION=0.1.0
GIT_COMMIT=unknown
BUILD_TIME=unknown

HOST=127.0.0.1
PORT=8080
BODY_LIMIT_BYTES=10485760
TRUST_PROXY=false

SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=hitman_session
CSRF_COOKIE_NAME=hitman_csrf
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8081
WORKER_POLL_INTERVAL_MS=5000

# Local development only. Replace with a secret manager reference in shared
# environments. Must be at least 16 characters.
METRICS_TOKEN=local-dev-metrics-token-change-me

SECRET_PROVIDER=env
OBJECT_STORAGE_DRIVER=disabled
SHUTDOWN_TIMEOUT_MS=10000

# Web development proxy target.
VITE_DEV_API_TARGET=http://127.0.0.1:8080
